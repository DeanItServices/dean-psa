# ---------------------------------------------------------------------------
# Postgres credentials
# ---------------------------------------------------------------------------
# Password for the `postgres` role. Used in THREE places by docker-compose.yml:
# the db service's POSTGRES_PASSWORD and both DATABASE_URLs (app, email-poller).
# There is no default -- compose fails fast if this is unset, by design.
#
# Generate with:  openssl rand -hex 32
#
# Use a URL-SAFE value. This password is embedded in the DATABASE_URL *URI*, so
# `+ / = @ : ? #` must not appear: `/` terminates the userinfo section, `+`
# decodes as a space and `=` is a sub-delimiter. A value containing them leaves
# the db container starting up perfectly healthy (it takes the password as an
# opaque literal) while only `app` fails to connect -- an asymmetric and
# maximally confusing failure. Hex has none of those characters.
#
# NOTE: POSTGRES_PASSWORD is applied by initdb ONLY, i.e. the first time the
# pgdata volume is created. Changing it against an existing volume requires an
# ALTER USER against the running database -- see DEPLOYMENT.md.
POSTGRES_PASSWORD=

# Host port the db service's Postgres container publishes to (docker-compose.yml).
# The mapping is loopback-scoped (`127.0.0.1:${DB_PORT}:5432`), so Postgres is
# reachable from this host -- which host-side tooling needs -- but not from
# anywhere else on the network.
# Change this per git worktree/checkout so concurrent worktrees don't collide on
# the same host port -- e.g. 5432 for the main checkout, 5433/5434/... for
# worktrees. Must match the port in DATABASE_URL below.
DB_PORT=5432

# Host-side connection string: the one used by `npm run db:migrate:deploy`,
# `npm run db:seed`, `npm run bootstrap:admin` and the E2E suite, all of which
# run on the host and reach Postgres over the loopback mapping above. The
# containers do NOT read this value -- compose builds their own DATABASE_URL
# from POSTGRES_PASSWORD, pointing at db:5432 on the internal network.
# Must be defined after POSTGRES_PASSWORD and DB_PORT for the expansion below to
# resolve. IMPORTANT -- who expands ${...} and who does not (verified):
#   - docker compose        expands it. OK.
#   - `set -a; . ./.env; set +a` in your shell, as DEPLOYMENT.md prescribes
#                           expands it. OK -- and because dotenv does not
#                           override a variable that is already exported, the
#                           Prisma-based scripts then see the expanded value.
#   - plain dotenv, which prisma7.config.ts loads via `import "dotenv/config"`
#                           does NOT expand. Running `npm run db:migrate:deploy`
#                           or `db:seed` WITHOUT exporting the variables first
#                           hands Prisma the literal `${POSTGRES_PASSWORD}` and
#                           fails with a connection error.
# So: source .env into your shell before running host-side scripts, or paste the
# literal password into the line below instead of the ${...} reference.
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/msp_psa?schema=public"

# ---------------------------------------------------------------------------
# Public site address and TLS (Caddy)
# ---------------------------------------------------------------------------
# The public hostname Caddy serves and obtains a certificate for, e.g.
# psa.example.com. Hostname only -- no scheme, no path, no port. There is no
# default: compose fails fast if it is unset, and Caddy would otherwise have no
# site to serve.
#
# Caddy issues the certificate automatically via the ACME HTTP-01 challenge on
# first request, which requires public DNS for this name to point at this host
# AND inbound TCP :80 to be reachable. Blocking :80 does not force HTTPS, it
# prevents issuance.
SITE_ADDRESS=

# Optional: host ports Caddy publishes. Defaults 80/443. Only change these to
# run a second stack side by side -- HTTP-01 issuance needs the real :80.
#HTTP_PORT=80
#HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: npx auth secret  (or: openssl rand -hex 32)
AUTH_SECRET=
# Must be the public https:// URL, matching SITE_ADDRESS. There is no default:
# compose fails fast if it is unset, because Auth.js decides whether to use the
# __Secure- cookie prefix from this URL's protocol alone -- an unset or http://
# value behind TLS silently issues a non-Secure session cookie, with no error.
# Changing the scheme logs every existing session out once; that is expected.
AUTH_URL=https://psa.example.com
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Rate limiting (optional overrides, read by src/proxy.ts at process start)
# ---------------------------------------------------------------------------
# All three are optional; leave them unset to keep the defaults below. They are
# read once when the app process starts, so changing one needs a restart of the
# app container. A value that is not a positive integer (including 0) is
# rejected with a warning and the default is used instead -- a typo cannot
# disable rate limiting.
# Window length in milliseconds. Default 60000 (60s).
#RATE_LIMIT_WINDOW_MS=60000
# Max requests per IP per window for general traffic. Default 60.
#RATE_LIMIT_GENERAL=60
# Max requests per IP per window for authentication endpoints. Default 10.
#RATE_LIMIT_AUTH=10

# ---------------------------------------------------------------------------
# Microsoft Graph API email-to-ticket poller (scripts/email-poller.ts)
# ---------------------------------------------------------------------------
# Requires an Azure AD app registration with Mail.Read (or Mail.ReadWrite)
# application permission, granted admin consent.
# Azure AD tenant ID for the app registration used by the email poller.
AZURE_TENANT_ID=
# Azure AD application (client) ID for the app registration.
AZURE_CLIENT_ID=
# Azure AD client secret for the app registration (application permissions, client credentials flow).
AZURE_CLIENT_SECRET=
# Email address of the shared mailbox the poller reads inbound mail from (e.g. support@yourdomain.com).
MAILBOX_ADDRESS=

# ---------------------------------------------------------------------------
# QuickBooks Online integration (OAuth2 connection + invoice push)
# ---------------------------------------------------------------------------
# Requires an Intuit developer app registration (https://developer.intuit.com).
# Client ID from the Intuit developer app registration.
QBO_CLIENT_ID=
# Client secret from the Intuit developer app registration.
QBO_CLIENT_SECRET=
# Valid values are sandbox/production.
QBO_ENVIRONMENT=sandbox
# Must match the redirect URI registered in the Intuit developer app EXACTLY.
# IMPORTANT: changing this value here is only half the job -- the same https://
# URI must ALSO be updated in the Intuit developer app registration. Intuit
# rejects any callback whose URI does not match the registered one, with an
# opaque error that nothing in this repo can diagnose or fix for you.
QBO_REDIRECT_URI=https://psa.example.com/api/qbo/callback

# ---------------------------------------------------------------------------
# Token encryption
# ---------------------------------------------------------------------------
# Encryption key for QuickBooks OAuth access/refresh tokens at rest
# (AES-256-GCM, src/lib/crypto.ts). Required before connecting QuickBooks.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing or losing this key invalidates any existing stored QuickBooks
# connection -- reconnect via /admin/quickbooks after rotating it.
TOKEN_ENCRYPTION_KEY=
