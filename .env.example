DATABASE_URL="postgresql://postgres:postgres@localhost:5432/msp_psa?schema=public"

# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Microsoft Graph API email-to-ticket poller (scripts/email-poller.ts).
# Requires an Azure AD app registration with Mail.Read (or Mail.ReadWrite)
# application permission, granted admin consent.
# Azure AD tenant ID for the app registration used by the email poller.
AZURE_TENANT_ID=
# Azure AD application (client) ID for the app registration.
AZURE_CLIENT_ID=
# Azure AD client secret for the app registration (application permissions, client credentials flow).
AZURE_CLIENT_SECRET=
# Email address of the shared mailbox the poller reads inbound mail from (e.g. support@yourdomain.com).
MAILBOX_ADDRESS=
