/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database dumps
# DEPLOYMENT.md's backup command writes msp_psa-<timestamp>.sql, and every
# command in that document runs from the repository root -- so without this a
# full dump of every ticket, client, invoice and password hash sits untracked in
# the working tree and is swept up by `git add -A`.
#
# Deliberately NOT a blanket `*.sql`: prisma/migrations/**/migration.sql are
# tracked files, and a blanket rule would silently ignore every new migration.
msp_psa-*.sql
