// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  technician
  dispatcher
  sales
  finance
  admin
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  hashedPassword     String?
  role               Role      @default(technician)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  // Token-generation counter. Every JWT carries the value that was current
  // when it was minted; getCurrentUser() refuses a token whose value differs
  // from this column. Incrementing it therefore revokes EVERY session issued
  // before the increment, which is what makes a password reset or change
  // actually terminate a stolen session -- rotating hashedPassword alone does
  // not, because a JWT session is self-contained and never re-checks the hash.
  tokenVersion       Int       @default(0)
  accounts           Account[]
  sessions           Session[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedTickets Ticket[]        @relation("AssignedTickets")
  ticketComments  TicketComment[] @relation("TicketCommentAuthor")
  timeEntries     TimeEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum BillingType {
  block_hour
  flat_fee
  hourly_breakfix
}

model Company {
  id            String   @id @default(cuid())
  name          String
  qboCustomerId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sites     Site[]
  contacts  Contact[]
  contracts Contract[]
  assets    Asset[]
  tickets   Ticket[]
  invoices  Invoice[]
}

model Site {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String
  isPrimary    Boolean @default(false)

  contacts Contact[]
  assets   Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteId    String?
  site      Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name  String
  email String?
  phone String?
  title String?

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Contract {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  billingType          BillingType
  blockHours           Int?
  flatFeeAmount        Decimal?    @db.Decimal(10, 2)
  hourlyRate           Decimal?    @db.Decimal(10, 2)
  slaResponseMinutes   Int?
  slaResolutionMinutes Int?

  startDate DateTime
  endDate   DateTime?

  tickets     Ticket[]
  timeEntries TimeEntry[]
  invoices    Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Asset {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteId    String?
  site      Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name         String
  assetType    String
  serialNumber String?
  notes        String? @db.Text

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

enum TicketStatus {
  new
  in_progress
  waiting_on_client
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum TicketSource {
  manual
  email
}

model Ticket {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  status   TicketStatus   @default(new)
  priority TicketPriority @default(normal)
  source   TicketSource   @default(manual)

  subject     String
  description String @db.Text

  slaResponseDeadline   DateTime?
  slaResolutionDeadline DateTime?
  firstRespondedAt      DateTime?
  resolvedAt            DateTime?

  comments    TicketComment[]
  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([createdAt])
}

model TicketComment {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  body       String  @db.Text
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())
}

enum InvoiceStatus {
  draft
  finalized
  pushed
}

model TimeEntry {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?
  isBillable      Boolean   @default(true)
  notes           String?

  invoiceLineItemId String?
  invoiceLineItem   InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startedAt])
}

model Invoice {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  periodStart DateTime
  periodEnd   DateTime
  status      InvoiceStatus @default(draft)
  subtotal    Decimal       @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(10, 2)

  qboInvoiceId String?
  qboPushedAt  DateTime?

  lineItems InvoiceLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([qboInvoiceId])
  @@index([companyId, periodStart, periodEnd])
}

model InvoiceLineItem {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitRate    Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)

  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
}

model QuickBooksConnection {
  id String @id @default(cuid())

  realmId              String
  accessToken          String   @db.Text
  refreshToken         String   @db.Text
  accessTokenExpiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
